  nodes:
  - id: greet
    speaker: Ashen Wanderer
    text: Ho there, traveler. The road to the shrine ahead is long, but rest waits
      at its end.
    portrait: {fileID: 0}
    voiceClip: {fileID: 0}
    cameraShotMarker:
    animationCue:
    choices:
    - text: Ask about the shrine ahead
      targetNodeId: shrine_info
      visibilityConditions: []
    - text: Move on
      targetNodeId:
      visibilityConditions: []
    mutations: []
  - id: shrine_info
    speaker: Ashen Wanderer
    text: Rest there, and the ashes will remember your passing. Go well, Jin
      Takakura.
    portrait: {fileID: 0}
    voiceClip: {fileID: 0}
    cameraShotMarker:
    animationCue:
    choices:
    - text: Farewell
      targetNodeId:
      visibilityConditions: []
